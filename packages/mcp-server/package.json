{
  "name": "@vybit/mcp-server",
  "version": "1.11.0",
  "description": "Model Context Protocol (MCP) server for Vybit Developer API (mcprush.com-08c42b50fc0ba98e59aa18e1)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vybit-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build:ui && tsc -b",
    "build:ui": "node scripts/build-ui.mjs",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "npm run build:ui && tsc --watch",
    "pretest": "npm run build:ui",
    "test": "jest --config ../../jest.config.js --rootDir ../..",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vybit",
    "mcp",
    "model-context-protocol",
    "developer-api",
    "ai",
    "claude",
    "notifications"
  ],
  "author": "Flatirontek LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/flatirontek/vybit-sdk.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://gitlab.com/flatirontek/vybit-sdk#readme",
  "bugs": {
    "url": "https://gitlab.com/flatirontek/vybit-sdk/-/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "manifest.json",
    "icon.png"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@vybit/api-sdk": "^1.3.0",
    "@vybit/core": "^1.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.3"
  }
}
